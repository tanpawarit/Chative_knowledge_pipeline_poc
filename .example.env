LOG_LEVEL="INFO"

# Local server port for the FastAPI receiver (avoid 4040; ngrok uses it for the web UI)
APP_SERVER_PORT="8000"

# ======= Environment variables for Extraction services =======
MISTRAL_KEY="__YOUR_MISTRAL_API_KEY__"
MISTRAL_OCR_MODEL="mistral-ocr-latest"
MISTRAL_PICTURE_MODEL="pixtral-12b"
MISTRAL_OCR_COST_PER_PAGE="0.001"
MISTRAL_PICTURE_INPUT_COST_PER_MILLION="0.15"
MISTRAL_PICTURE_OUTPUT_COST_PER_MILLION="0.15"
OPENAI_EMBED_USD_PER_MILLION="0.02"

# ======= Database settings =======
DB_HOST="localhost"
DB_PORT="6000"
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_NAME="chative"
DB_SSLMODE="disable"
DB_READ_TIMEOUT="30"
DATABASE_URL="postgres://postgres:postgres@localhost:6000/chative?sslmode=disable"

# ======= Environment variables for Chunking and Embedding services =======
OPENAI_API_KEY="__YOUR_OPENAI_API_KEY__"
OPENAI_EMBED_MODEL="text-embedding-3-small"

MILVUS_ADDR="https://in05-fdbc29054719267.serverless.aws-eu-central-1.cloud.zilliz.com"
MILVUS_USERNAME="__YOUR_MILVUS_USERNAME__"
MILVUS_PASSWORD="__YOUR_MILVUS_PASSWORD__"
MILVUS_COLLECTION="knowledge_base"
MILVUS_DENSE_METRIC="COSINE"
MILVUS_SPARSE_METRIC="BM25"
MILVUS_CONSISTENCY_LEVEL="Bounded"
# Character-based sizing for semantic chunks
MIN_CHARS="400"

# Pre-split controls for Markdown splitter
PRESPLIT_MIN_CHARS="1200"
PRESPLIT_OVERLAP_CHARS="0"

# SemanticChunker controls (see Settings in config.py)
SEMANTIC_BUFFER_SIZE="1"
SEMANTIC_BREAKPOINT_TYPE="percentile"
# Set to a number (e.g., 70) to override default percentile threshold; leave blank or "auto" for default
SEMANTIC_BREAKPOINT_AMOUNT="auto"

# Texts per batch when calling the embedding API. Tune for throughput vs. rate limits/memory.
BATCH_SIZE="64"

# ======= Storage (R2/local) =======
R2_ACCOUNT_ID="__YOUR_R2_ACCOUNT_ID__"
R2_ACCESS_KEY_ID="__YOUR_R2_ACCESS_KEY__"
R2_SECRET_ACCESS_KEY="__YOUR_R2_SECRET__"
R2_CUSTOMER_UPLOAD_BUCKET="customer-uploads"

# ======= QStash (Upstash) ======= 
QSTASH_TOKEN="__YOUR_QSTASH_REST_TOKEN__"
QSTASH_CURRENT_SIGNING_KEY="__CURRENT_SIGNING_KEY__"
QSTASH_NEXT_SIGNING_KEY="__NEXT_SIGNING_KEY__"
QSTASH_RECEIVER_URL="https://<your-ngrok-subdomain>.ngrok-free.app/qstash/receive"
